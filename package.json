{
  "name": "seria",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Seria - a gym training web app: weekly plan, guided sets, history, Claude coach.",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "vendor": "node scripts/build-vendor.mjs",
    "rules-doc": "node scripts/build-rules-doc.mjs",
    "build:artifact": "node scripts/build-artifact.mjs",
    "smoke": "node tests/e2e/smoke.mjs",
    "smoke:shots": "node tests/e2e/smoke.mjs --shots",
    "report": "node scripts/build-report.mjs",
    "check:live": "node scripts/check-live.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "esbuild": "^0.28.2",
    "htm": "^3.1.1",
    "playwright-core": "^1.65.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dglowinski/seria.git"
  },
  "homepage": "https://dglowinski.github.io/seria/"
}
